# Copy this file to .env and fill in real values.
# Never commit .env. Never paste these values into Telegram.

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=

XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
NODE_ENV=development
APP_TIMEZONE=Asia/Dubai

# Optional settings. The defaults are safe for a single local process.
# polling = local development. webhook = public HTTPS deployment.
TELEGRAM_MODE=polling
# Leave as the official cloud API unless you run telegram-bot-api yourself.
TELEGRAM_API_ROOT=https://api.telegram.org
# Public HTTPS origin used only when TELEGRAM_MODE=webhook, no trailing path.
PUBLIC_BASE_URL=
# Protects POST /internal/reminders/process. Use a long random string in production.
CRON_SECRET=
# In-process reminder worker. Set to 0 when an external cron calls the HTTP endpoint.
REMINDER_POLL_MS=30000
# Published grok-4.7 list price as of 10 Oct 2026. Check console.x.ai before relying on estimates.
XAI_INPUT_USD_PER_MILLION=2
XAI_OUTPUT_USD_PER_MILLION=6
XAI_TIMEOUT_MS=45000
LOG_LEVEL=info
MAX_UPLOAD_BYTES=20971520
