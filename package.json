{
  "name": "it-work-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal IT work copilot for Telegram, backed by Grok and Supabase.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "grammy": "^1.38.2",
    "luxon": "^3.7.1",
    "mammoth": "^1.10.0",
    "openai": "^6.49.0",
    "pino": "^9.9.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/express": "^4.17.23",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.2.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.32.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "minimatch": "^11.0.1"
  }
}
