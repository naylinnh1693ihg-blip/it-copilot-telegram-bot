# Copy to .env.monitoring. Keep this file local and gitignored.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_PORT=3001

# Configure an encrypted rclone crypt remote named drive-crypt on this PC.
RCLONE_REMOTE=drive-crypt:it-work-copilot-backups
RCLONE_CONFIG_PASS=

# Required for email notifications. Keep credentials local.
GF_SMTP_ENABLED=true
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
ALERT_EMAIL_TO=

# Dedicated Telegram monitoring bot credentials; never use the production bot token.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
