{
  "id": null,
  "uid": "it-work-copilot-overview",
  "title": "IT Work Copilot",
  "tags": ["application", "containers"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum by (route) (rate(it_work_http_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "HTTP 5xx errors / second",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum by (route) (rate(it_work_http_errors_total[5m]))", "legendFormat": "{{route}}", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "HTTP request latency p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(it_work_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "App resident memory",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "it_work_process_resident_memory_bytes", "legendFormat": "bytes", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "Container CPU cores",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\".*it-work-copilot.*\"}[5m]))", "legendFormat": "{{name}}", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "Container memory",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{ "expr": "sum by (name) (container_memory_working_set_bytes{name=~\".*it-work-copilot.*\"})", "legendFormat": "{{name}}", "refId": "A" }]
    }
  ]
}
