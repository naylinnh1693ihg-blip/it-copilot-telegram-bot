{
  "name": "it-work-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal IT work copilot for Telegram, backed by Grok and Supabase.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json && npm run build:admin",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p web/admin/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "ingest": "tsx src/jobs/ingestKnowledge.ts",
    "link-notes": "tsx src/jobs/linkNotes.ts",
    "test:rag": "tsx src/jobs/testRagPrompt.ts",
    "build:admin": "vite build --config web/admin/vite.config.ts",
    "dev:admin": "vite --config web/admin/vite.config.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@supabase/supabase-js": "^2.49.8",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "grammy": "^1.38.2",
    "luxon": "^3.7.1",
    "mammoth": "^1.10.0",
    "openai": "^6.49.0",
    "pino": "^9.9.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tanstack/react-query": "5.105.0",
    "@types/express": "^4.17.23",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "minimatch": "^11.0.1"
  }
}
