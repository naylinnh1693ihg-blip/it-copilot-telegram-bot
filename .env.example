# Copy this file to .env and fill in real values.
# Never commit .env. Never paste these values into Telegram.

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=
# Gap between edits of a streaming reply. Telegram allows about one edit per second per chat.
TELEGRAM_EDIT_INTERVAL_MS=1100

XAI_API_KEY=
XAI_MODEL=grok-4.7
# Photos and screenshots. both keeps OCR for search and sends the picture to Grok.
# vision skips OCR unless the vision call fails. ocr never sends the picture.
VISION_MODE=both
# Empty uses XAI_MODEL. grok-4.7 accepts image input.
XAI_VISION_MODEL=
# Embeddings for notes, knowledge, and document chunks. Width must match the pgvector column (1024).
XAI_EMBEDDING_MODEL=v1
XAI_EMBEDDING_DIMENSIONS=1024
# Narrative chunk size is tokens, estimated as characters / 4. Default stays inside 400–600.
# Overlap is about one sentence. Identifier passages are a separate 50–150 token window.
RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP_TOKENS=80
RAG_TOP_K=6
# Drop chunk hits below this hybrid score. The database still ignores weak trigram matches under 0.4.
RAG_MIN_SCORE=0.4
# Prompt context budget for retrieved chunks. Estimated as characters / 4.
RAG_CONTEXT_TOKENS=3000
# Document analysis only. Short text uses XAI_MODEL. Longer text uses these.
# Estimated tokens are characters / 4. Under 120000 → XAI_MODEL.
# 120000–400000 → XAI_MODEL_LONG. Above 400000 → XAI_MODEL_MAX, then the middle is omitted.
# Stored text from PDF, DOCX, spreadsheets, and plain files. 600000 characters is about 150000 tokens.
# The hard ceiling is 800000 characters.
DOCUMENT_EXTRACT_MAX_CHARS=600000
XAI_MODEL_LONG=grok-4.20
XAI_MODEL_MAX=grok-4.20
XAI_ANALYSIS_STANDARD_TOKENS=120000
XAI_ANALYSIS_LONG_TOKENS=400000
XAI_BASE_URL=https://api.x.ai/v1

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
NODE_ENV=development
APP_TIMEZONE=Asia/Dubai

# Optional settings. The defaults are safe for a single local process.
# polling = local development. webhook = public HTTPS deployment.
TELEGRAM_MODE=polling
# Gap between edits of a streaming reply. Telegram allows about one edit per second per chat.
TELEGRAM_EDIT_INTERVAL_MS=1100
# Leave as the official cloud API unless you run telegram-bot-api yourself.
TELEGRAM_API_ROOT=https://api.telegram.org
# Public HTTPS origin used only when TELEGRAM_MODE=webhook, no trailing path.
PUBLIC_BASE_URL=
# Protects POST /internal/reminders/process. Use a long random string in production.
CRON_SECRET=
# In-process reminder worker. Set to 0 when an external cron calls the HTTP endpoint.
REMINDER_POLL_MS=30000
# Published grok-4.7 list price as of 10 Oct 2026. Check console.x.ai before relying on estimates.
XAI_INPUT_USD_PER_MILLION=2
XAI_OUTPUT_USD_PER_MILLION=6
XAI_TIMEOUT_MS=45000
LOG_LEVEL=info
MAX_UPLOAD_BYTES=20971520
